{
  "name": "Almacen Unity — BI",
  "dataColors": ["#1B6CA8", "#F0A202", "#2A9D8F", "#C44536", "#8FB8DE", "#0B2545", "#6B7280", "#E9C46A"],
  "background": "#FFFFFF",
  "foreground": "#1F2937",
  "tableAccent": "#1B6CA8",
  "textClasses": {
    "callout": { "fontSize": 26, "fontFace": "Segoe UI Semibold", "color": "#0B2545" },
    "title": { "fontSize": 13, "fontFace": "Segoe UI Semibold", "color": "#0B2545" },
    "header": { "fontSize": 11, "fontFace": "Segoe UI Semibold", "color": "#1B6CA8" },
    "label": { "fontSize": 9, "fontFace": "Segoe UI", "color": "#4B5563" }
  },
  "visualStyles": {
    "*": {
      "*": {
        "background": [{ "show": true, "color": { "solid": { "color": "#FFFFFF" } }, "transparency": 0 }],
        "border": [{ "show": true, "color": { "solid": { "color": "#E1E7ED" } }, "radius": 6 }],
        "visualHeader": [{ "show": false }],
        "title": [{ "fontSize": 11, "fontColor": { "solid": { "color": "#0B2545" } }, "alignment": "left" }]
      }
    },
    "page": {
      "*": {
        "outspace": [{ "color": { "solid": { "color": "#F4F6F8" } } }],
        "background": [{ "color": { "solid": { "color": "#F4F6F8" } }, "transparency": 0 }]
      }
    },
    "card": {
      "*": {
        "labels": [{ "fontSize": 24, "color": { "solid": { "color": "#0B2545" } } }],
        "categoryLabels": [{ "fontSize": 9, "color": { "solid": { "color": "#6B7280" } } }]
      }
    },
    "slicer": {
      "*": {
        "header": [{ "fontColor": { "solid": { "color": "#1B6CA8" } }, "fontSize": 10 }]
      }
    }
  }
}
